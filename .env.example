# =============================================================================
# Variables de entorno — Portal de Transparencia OC/OS
# =============================================================================
# Copiar este archivo a `.env` y completar los valores reales.
# `.env` está en .gitignore: NUNCA se commitea.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
# Next.js lo define solo: "development" en `next dev` y "production" en `next start`.
# No hace falta ponerlo en `.env`; se documenta porque `lib/env.ts` lo lee.
# NODE_ENV="development"

# --- Base de datos (Neon PostgreSQL) -----------------------------------------
# Host con pooling (PgBouncer). Se usa en runtime de la aplicación.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Host directo, SIN pooling. Necesario para que Prisma ejecute migraciones.
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Autenticación -----------------------------------------------------------
# Generar con:  openssl rand -base64 32
AUTH_SECRET="genera-un-secreto-aleatorio-de-32-bytes"

# --- Seed --------------------------------------------------------------------
# Correo y contraseña del primer usuario SUPERADMIN. Solo los usa el script de seed.
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="cambia-esta-password"

# --- Cloudinary: fotografías privadas de proveedores ------------------------
# Las fotos nuevas siempre se suben a Cloudinary con estas tres credenciales.
# No hace falta un upload preset ni cambiar STORAGE_DRIVER.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Almacenamiento de archivos originales -----------------------------------
# "local" guarda en STORAGE_LOCAL_DIR (desarrollo).
# "cloudinary" sube a Cloudinary (fase posterior).
STORAGE_DRIVER="local"

# Directorio del disco para STORAGE_DRIVER=local. Debe existir y poder escribirse.
STORAGE_LOCAL_DIR="./storage/uploads"

# --- Sitio -------------------------------------------------------------------
# URL pública del portal: la usan el canónico, OpenGraph, el sitemap y robots.txt.
# No es un secreto (viaja en el HTML). En Render se define en render.yaml.
NEXT_PUBLIC_SITE_URL="https://fiscalizador.onrender.com"

# --- Contacto público (portal ciudadano) -------------------------------------
# Correo que se muestra en /metodologia para solicitar correcciones.
# Es público: se incrusta en el HTML al compilar. Si se deja vacío, la página
# avisa de que el canal no está configurado.
NEXT_PUBLIC_CONTACTO_CORRECCIONES=""

# Nombre oficial de la municipalidad vigilada, visible en el encabezado.
NEXT_PUBLIC_MUNICIPALIDAD=""
