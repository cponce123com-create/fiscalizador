{
  "manifest_version": 3,
  "name": "Fiscalizador · Descarga anual SEACE",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Descarga los doce Excel mensuales en tu computadora, uno por vez.",
  "key": "",
  "permissions": [
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://prod2.seace.gob.pe/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://fiscalizador.onrender.com/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Descargar Excel anual SEACE"
  }
}
